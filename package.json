{
  "name": "pi-dev",
  "version": "1.0.0",
  "description": "Personal pi toolkit for daily development — skills, prompts, and extensions",
  "keywords": [
    "pi-package"
  ],
  "author": "fanjunjie",
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./extensions",
      "node_modules/pi-rewind/src/index.ts",
      "node_modules/pi-web-access/index.ts",
      "node_modules/pi-superpowers/extensions/plan-tracker.ts",
      "node_modules/pi-chrome/extensions/chrome-profile-bridge/index.ts",
      "node_modules/pi-mcp-adapter/index.ts",
      "node_modules/statusline-pi/dist/index.js",
      "node_modules/context-mode/build/adapters/pi/extension.js",
      "node_modules/pi-subagents/src/extension/index.ts",
      "node_modules/pi-agent-goal/extensions/index.ts"
    ],
    "skills": [
      "./skills",
      "node_modules/pi-playwright/skills",
      "node_modules/pi-superpowers/skills",
      "node_modules/context-mode/skills",
      "node_modules/pi-subagents/skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "dependencies": {
    "context-mode": "^1.0.162",
    "pi-agent-goal": "github:KristjanPikhof/Pi-Agent-Goal",
    "pi-chrome": "^0.15.38",
    "pi-mcp-adapter": "^2.10.0",
    "pi-playwright": "^0.1.1",
    "pi-rewind": "^0.5.0",
    "pi-subagents": "^0.31.0",
    "pi-superpowers": "^0.2.0",
    "pi-web-access": "^0.13.0",
    "statusline-pi": "^1.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/setup-skills.js",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0"
  },
  "bundleDependencies": [
    "pi-rewind",
    "pi-web-access",
    "pi-playwright",
    "pi-superpowers",
    "pi-chrome",
    "pi-mcp-adapter",
    "statusline-pi",
    "context-mode",
    "pi-subagents",
    "pi-agent-goal"
  ]
}
