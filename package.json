{
	"name": "pi-dev",
	"version": "1.0.0",
	"description": "Personal pi toolkit for daily development — skills, prompts, and extensions",
	"keywords": [
		"pi-package"
	],
	"author": "fanjunjie",
	"license": "MIT",
	"pi": {
		"extensions": [
			"./extensions",
			"node_modules/@narumitw/pi-btw/src/index.ts",
			"node_modules/@narumitw/pi-plan-mode/src/index.ts",
			"node_modules/pi-rewind/src/index.ts",
			"node_modules/pi-web-access/index.ts",
			"node_modules/pi-mcp-adapter/index.ts",
			"node_modules/context-mode/build/adapters/pi/extension.js",
			"node_modules/pi-subagents/index.ts",
			"node_modules/visual-explainer/plugins/visual-explainer/extension.ts",
			"node_modules/pi-review-loop/index.ts"
		],
		"skills": [
			"./skills",
			"node_modules/@playwright/cli/skills/playwright-cli",
			"node_modules/context-mode/skills",
			"node_modules/pi-subagents/skills",
			"node_modules/visual-explainer/plugins/visual-explainer"
		],
		"prompts": [
			"./prompts",
			"node_modules/pi-subagents/prompts",
			"node_modules/visual-explainer/plugins/visual-explainer/commands",
			"node_modules/pi-review-loop/prompts"
		],
		"themes": [
			"./themes"
		]
	},
	"dependencies": {
		"@narumitw/pi-btw": "^0.56.2",
		"@narumitw/pi-plan-mode": "^0.56.0",
		"@playwright/cli": "^0.1.19",
		"context-mode": "^1.0.169",
		"pi-mcp-adapter": "^2.32.1",
		"pi-review-loop": "^0.4.4",
		"pi-rewind": "^0.5.0",
		"pi-subagents": "^0.64.0",
		"pi-web-access": "^0.27.0",
		"visual-explainer": "^0.11.0"
	},
	"scripts": {
		"postinstall": "node scripts/setup-skills.js",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"format": "biome format --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12"
	},
	"bundleDependencies": [
		"pi-mcp-adapter",
		"context-mode",
		"pi-review-loop",
		"pi-subagents",
		"pi-web-access",
		"visual-explainer",
		"@playwright/cli",
		"@narumitw/pi-btw",
		"@narumitw/pi-plan-mode"
	]
}
